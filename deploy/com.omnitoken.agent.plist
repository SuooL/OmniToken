<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd agent for macOS. Install:
     cp com.omnitoken.agent.plist ~/Library/LaunchAgents/
     launchctl load ~/Library/LaunchAgents/com.omnitoken.agent.plist
     (replace "agent" with "serve" in ProgramArguments for the server machine) -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.omnitoken.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/omnitoken</string>
    <string>agent</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/omnitoken-agent.log</string>
  <key>StandardErrorPath</key><string>/tmp/omnitoken-agent.log</string>
</dict>
</plist>
