{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniToken",
  "version": "0.1.0",
  "identifier": "com.suool.omnitoken.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "panel",
        "title": "OmniToken",
        "width": 340,
        "height": 430,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "windowEffects": {
          "effects": ["popover"],
          "state": "active",
          "radius": 14
        }
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true,
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
